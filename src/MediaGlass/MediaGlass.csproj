<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MediaGlass</AssemblyName>
    <RootNamespace>MediaGlass</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <Authors>MySystem</Authors>
    <Product>Media Glass Controller - MySystem</Product>
    <Description>A draggable Windows 11 glass media controller with thumbnail theming and timeline seeking.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\App.ico" LogicalName="MediaGlass.App.ico" />
  </ItemGroup>
</Project>
