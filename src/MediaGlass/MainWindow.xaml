<Window x:Class="MediaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Media Glass Controller - MySystem"
        Width="470"
        Height="176"
        MinWidth="410"
        MinHeight="158"
        MaxWidth="650"
        MaxHeight="230"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="White"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Margin="8"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="#50FFFFFF"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              Direction="270"
                              ShadowDepth="7"
                              Opacity="0.52"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Image Source="{Binding Artwork}"
                   Stretch="UniformToFill"
                   Opacity="0.52">
                <Image.Effect>
                    <BlurEffect Radius="34" KernelType="Gaussian" />
                </Image.Effect>
            </Image>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{Binding ThemeStart}" Offset="0" />
                        <GradientStop Color="{Binding ThemeEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="#18000000" />

            <Grid Margin="13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,13,0"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="#54FFFFFF">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="9,3"
                                CornerRadius="9"
                                Background="#24FFFFFF"
                                BorderBrush="#2FFFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Source}"
                                       FontSize="10.5"
                                       Foreground="#DFFFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="175" />
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="LockButton"
                                    Style="{StaticResource WindowActionButton}"
                                    Content="&#xE72E;"
                                    Click="OnLockButtonClick" />
                            <Button x:Name="CloseButton"
                                    Style="{StaticResource WindowActionButton}"
                                    Content="&#xE8BB;"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding Artist}"
                               FontSize="11"
                               Foreground="#BFFFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" />

                    <Grid Grid.Row="3" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="39" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PositionText}"
                                   FontSize="9.5"
                                   Foreground="#D9FFFFFF"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="TimelineSlider"
                                Grid.Column="1"
                                Margin="3,0,5,0"
                                Style="{StaticResource GlassSlider}"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                IsEnabled="{Binding CanSeek}"
                                PreviewMouseLeftButtonDown="OnTimelineMouseDown"
                                PreviewMouseLeftButtonUp="OnTimelineMouseUp">
                            <Slider.Foreground>
                                <SolidColorBrush Color="{Binding Accent}" />
                            </Slider.Foreground>
                        </Slider>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DurationText}"
                                   FontSize="9.5"
                                   Foreground="#D9FFFFFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                        <Button Style="{StaticResource GlassIconButton}"
                                Content="&#xE892;"
                                ToolTip="Previous"
                                IsEnabled="{Binding CanGoPrevious}"
                                Command="{Binding PreviousCommand}" />
                        <Button Style="{StaticResource GlassIconButton}"
                                Width="39"
                                Height="39"
                                FontSize="18"
                                Content="{Binding PlayPauseGlyph}"
                                ToolTip="Play / Pause"
                                IsEnabled="{Binding HasMedia}"
                                Command="{Binding TogglePlayPauseCommand}" />
                        <Button Style="{StaticResource GlassIconButton}"
                                Content="&#xE893;"
                                ToolTip="Next"
                                IsEnabled="{Binding CanGoNext}"
                                Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
