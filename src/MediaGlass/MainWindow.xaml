<Window x:Class="MediaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Media Glass Controller - MySystem"
        Width="300"
        Height="100"
        MinWidth="270"
        MinHeight="90"
        MaxWidth="420"
        MaxHeight="140"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Foreground="White"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#50FFFFFF"
            ClipToBounds="True">
        <Grid>
            <Image Source="{Binding Artwork}"
                   Stretch="UniformToFill"
                   Opacity="0.58">
                <Image.Effect>
                    <BlurEffect Radius="28" KernelType="Gaussian" />
                </Image.Effect>
            </Image>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{Binding ThemeStart}" Offset="0" />
                        <GradientStop Color="{Binding ThemeEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="#10000000" />

            <Grid Margin="8,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="LockButton"
                            Style="{StaticResource WindowActionButton}"
                            Content="&#xE72E;"
                            Click="OnLockButtonClick" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WindowActionButton}"
                            Content="&#xE8BB;"
                            Click="OnCloseButtonClick" />
                </StackPanel>

                <Slider x:Name="TimelineSlider"
                        Grid.Row="1"
                        Margin="2,0"
                        Style="{StaticResource GlassSlider}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        IsEnabled="{Binding CanSeek}"
                        PreviewMouseLeftButtonDown="OnTimelineMouseDown"
                        PreviewMouseLeftButtonUp="OnTimelineMouseUp">
                    <Slider.Foreground>
                        <SolidColorBrush Color="{Binding Accent}" />
                    </Slider.Foreground>
                </Slider>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassIconButton}"
                            Content="&#xE892;"
                            ToolTip="Previous"
                            IsEnabled="{Binding CanGoPrevious}"
                            Command="{Binding PreviousCommand}" />
                    <Button Style="{StaticResource GlassIconButton}"
                            Width="30"
                            Height="30"
                            FontSize="15"
                            Content="{Binding PlayPauseGlyph}"
                            ToolTip="Play / Pause"
                            IsEnabled="{Binding HasMedia}"
                            Command="{Binding TogglePlayPauseCommand}" />
                    <Button Style="{StaticResource GlassIconButton}"
                            Content="&#xE71A;"
                            ToolTip="Stop"
                            IsEnabled="{Binding CanStop}"
                            Command="{Binding StopCommand}" />
                    <Button Style="{StaticResource GlassIconButton}"
                            Content="&#xE893;"
                            ToolTip="Next"
                            IsEnabled="{Binding CanGoNext}"
                            Command="{Binding NextCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
