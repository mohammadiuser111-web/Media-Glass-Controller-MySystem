<Window x:Class="MediaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Media Glass Controller - MySystem"
        Width="330"
        Height="112"
        MinWidth="300"
        MinHeight="104"
        MaxWidth="480"
        MaxHeight="150"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Foreground="White"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#50FFFFFF"
            ClipToBounds="True">
        <Grid>
            <Image Source="{Binding Artwork}"
                   Stretch="UniformToFill"
                   Opacity="0.52">
                <Image.Effect>
                    <BlurEffect Radius="30" KernelType="Gaussian" />
                </Image.Effect>
            </Image>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{Binding ThemeStart}" Offset="0" />
                        <GradientStop Color="{Binding ThemeEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="#12000000" />

            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#54FFFFFF">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="23" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,5,0"
                                   Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="LockButton"
                                    Style="{StaticResource WindowActionButton}"
                                    Content="&#xE72E;"
                                    Click="OnLockButtonClick" />
                            <Button x:Name="CloseButton"
                                    Style="{StaticResource WindowActionButton}"
                                    Content="&#xE8BB;"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Artist}"
                               FontSize="9.5"
                               Foreground="#C8FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="29" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="33" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PositionText}"
                                   FontSize="8"
                                   Foreground="#D9FFFFFF"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="TimelineSlider"
                                Grid.Column="1"
                                Margin="2,0,4,0"
                                Style="{StaticResource GlassSlider}"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                IsEnabled="{Binding CanSeek}"
                                PreviewMouseLeftButtonDown="OnTimelineMouseDown"
                                PreviewMouseLeftButtonUp="OnTimelineMouseUp">
                            <Slider.Foreground>
                                <SolidColorBrush Color="{Binding Accent}" />
                            </Slider.Foreground>
                        </Slider>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DurationText}"
                                   FontSize="8"
                                   Foreground="#D9FFFFFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassIconButton}"
                                Content="&#xE892;"
                                ToolTip="Previous"
                                IsEnabled="{Binding CanGoPrevious}"
                                Command="{Binding PreviousCommand}" />
                        <Button Style="{StaticResource GlassIconButton}"
                                Width="30"
                                Height="30"
                                FontSize="15"
                                Content="{Binding PlayPauseGlyph}"
                                ToolTip="Play / Pause"
                                IsEnabled="{Binding HasMedia}"
                                Command="{Binding TogglePlayPauseCommand}" />
                        <Button Style="{StaticResource GlassIconButton}"
                                Content="&#xE893;"
                                ToolTip="Next"
                                IsEnabled="{Binding CanGoNext}"
                                Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
